# Card Scanner Configuration
# Copy this file to .env and modify as needed

# Database settings
# CARD_SCANNER_DATABASE_PATH=database.db
# CARD_SCANNER_CSV_PATH=categories/

# Authentication (comma-separated list of API keys)
# Leave empty to disable authentication (default)
# CARD_SCANNER_API_KEYS=your-api-key-1,your-api-key-2

# CORS settings (comma-separated list of origins)
# Use * for all origins (default)
# CARD_SCANNER_CORS_ORIGINS=https://example.com,https://app.example.com

# File upload limits (in bytes)
# CARD_SCANNER_MAX_FILE_SIZE=10485760  # 10MB

# Server settings
# CARD_SCANNER_HOST=0.0.0.0
# CARD_SCANNER_PORT=8000

# External service URLs
# CARD_SCANNER_TCG_CSV_URL=https://tcgcsv.com/tcgplayer/

# SigLIP2 LoRA vector index (embeddings.pt + LoRA adapter directory)
# CARD_SCANNER_SIGLIP_HF_REPO_ID=jackttv/card-scanner-siglip-lora
# CARD_SCANNER_SIGLIP_VECTORS_PATH=siglip_vectors

# YOLO pose detector (corner-keypoint model)
# CARD_SCANNER_YOLO_HF_REPO_ID=jackttv/card-scanner-yolo-pose
# CARD_SCANNER_YOLO_HF_FILENAME=best.pt
# CARD_SCANNER_YOLO_MODEL_PATH=models/pose_best.pt
# CARD_SCANNER_YOLO_CONFIDENCE_THRESHOLD=0.6

# Timeouts (in seconds)
# CARD_SCANNER_HTTP_TIMEOUT=30.0
# CARD_SCANNER_YOLO_TIMEOUT=30.0

# Default categories (comma-separated)
# 3 = Pokemon
# CARD_SCANNER_DEFAULT_CATEGORIES=3

# Scheduled update times (24-hour format)
# CARD_SCANNER_DB_UPDATE_HOUR=3
# CARD_SCANNER_DB_UPDATE_MINUTE=0
# CARD_SCANNER_VECTORS_UPDATE_HOUR=4
# CARD_SCANNER_VECTORS_UPDATE_MINUTE=0

# Concurrency limits
# CARD_SCANNER_MAX_CONCURRENT_DOWNLOADS=5

# Retry settings
# CARD_SCANNER_RETRY_ATTEMPTS=3
# CARD_SCANNER_RETRY_MIN_WAIT=1.0
# CARD_SCANNER_RETRY_MAX_WAIT=10.0

# Rate limiting (requests per minute)
# CARD_SCANNER_RATE_LIMIT_SCAN=10
# CARD_SCANNER_RATE_LIMIT_IDENTIFY=30
# CARD_SCANNER_RATE_LIMIT_PRICE=60
# CARD_SCANNER_RATE_LIMIT_UPDATE=1

# Logging
# CARD_SCANNER_LOG_LEVEL=INFO
# CARD_SCANNER_LOG_JSON=true
